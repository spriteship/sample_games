{
  "name": "spriteship-game-samples",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "spriteship-game-samples",
      "version": "0.1.0",
      "workspaces": [
        "games/*"
      ]
    },
    "games/emberhold": {
      "name": "@spriteship/emberhold",
      "version": "1.0.0"
    },
    "games/last-light": {
