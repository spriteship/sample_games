config_version=5

[application]
config/name="Emberhold: The Last Hearth"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="res://assets/spriteship/menu/item-0.png"
boot_splash/bg_color=Color(0.063, 0.106, 0.094, 1)
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.075, 0.12, 0.11, 1)

[audio]
driver/enable_input=false
